{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Devin benchmark result",
  "type": "object",
  "required": ["experiment_id", "case_id", "agent", "prompt", "started_at", "ended_at", "elapsed_seconds", "interventions", "patch", "tests_before", "tests_after", "pass", "regression_status", "evaluator_notes"],
  "properties": {
    "experiment_id": {"type": "string"},
    "case_id": {"type": "string"},
    "agent": {
      "type": "object",
      "required": ["name", "configuration", "model", "subscription_or_usage"],
      "properties": {
        "name": {"type": "string"},
        "configuration": {"type": "string"},
        "model": {"type": "string"},
        "subscription_or_usage": {
          "type": "object",
          "required": ["available", "amount", "currency"],
          "properties": {
            "available": {"type": "boolean"},
            "amount": {"type": ["number", "null"]},
            "currency": {"type": ["string", "null"]}
          }
        }
      }
    },
    "prompt": {"type": "string"},
    "started_at": {"type": "string"},
    "ended_at": {"type": "string"},
    "elapsed_seconds": {"type": ["number", "null"]},
    "interventions": {"type": "array", "items": {"type": "object"}},
    "patch": {
      "type": "object",
      "required": ["format", "path", "sha256"],
      "properties": {
        "format": {"type": "string"},
        "path": {"type": "string"},
        "sha256": {"type": "string"}
      }
    },
    "tests_before": {"type": "object"},
    "tests_after": {"type": "object"},
    "pass": {"type": ["boolean", "null"]},
    "regression_status": {"type": "string", "enum": ["not-run", "clean", "regression", "inconclusive"]},
    "evaluator_notes": {"type": "string"}
  }
}
